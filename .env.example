# ─── Sanity CMS ─────────────────────────────────────────────────────────────
# Get these from sanity.io after running `npx sanity init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Free tier: 3,000 emails/month — resend.com
RESEND_API_KEY=

# ─── AI APIs ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── Upstash Redis ───────────────────────────────────────────────────────────
# Create a database at console.upstash.com → Settings → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=

# ─── OTP (WhatsApp) ──────────────────────────────────────────────────────────
# Separate from AUTH_JWT_SECRET — used to HMAC-hash OTPs before storage.
# Generate with: openssl rand -hex 32
OTP_HASH_SECRET=07f617e6c02a9284355b37672c2eb20272b4f940cf0a7f47ff9086df2065b9b1

# OTP time-to-live in seconds (default 300 = 5 minutes)
OTP_TTL_SECONDS=300

# ───    ───────────────────────────────────────────────
# 1. Create a Meta for Developers app at https://developers.facebook.com
# 2. Add the WhatsApp product to your app
# 3. Set up a WhatsApp Business Account (WABA)
# 4. Retrieve these values from:
#    Meta Dashboard → WhatsApp → API Setup
WHATSAPP_API_TOKEN=            # Temporary or permanent access token
WHATSAPP_PHONE_NUMBER_ID=      # Phone Number ID (not the phone number itself)
WHATSAPP_BUSINESS_ACCOUNT_ID=  # WhatsApp Business Account ID

# WhatsApp message template name (must be approved in Meta Business Manager)
# Template body: "Your RasteAurRahein verification code is {{1}}. It expires in
#                 5 minutes. Do not share this code with anyone."
WHATSAPP_TEMPLATE_NAME=otp_verification

# ─── Site URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://raste-aur-rahein.vercel.app/

# ─── Measurement & Analytics (GA4) ──────────────────────────────────────────
# Primary GA4 Measurement ID for Next.js App Router (G-XXXXXXXXXX)
# Obtain from analytics.google.com → Admin → Data Streams → Web Stream
NEXT_PUBLIC_GA4_ID=G-BGNERJ2GNL
# Backward-compatible fallback alias:
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-BGNERJ2GNL

# Internal traffic exclusion: comma-separated list of home/office static public IPs
# Used for server-side IP filtering and documentation reference for GA4 IP filters
# Example: NEXT_PUBLIC_INTERNAL_IPS=203.0.113.195,198.51.100.42
NEXT_PUBLIC_INTERNAL_IPS=

# ─── Search Engine Verification ──────────────────────────────────────────────
# Google Search Console HTML meta tag token (content attribute only):
# search.google.com/search-console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=BIEenwmGrsRC5bsvFN9U6T7pYVD2082zfSkxi4CObA4

# Bing Webmaster Tools msvalidate.01 meta tag content:
# bing.com/webmasters → Settings → Ownership verification → HTML meta tag
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Newsletter Providers (Lead Capture & Route Report) ───────────────────────
# The site auto-routes newsletter & GPX downloads through Resend, Buttondown, or Brevo:
# RESEND_API_KEY is configured above. Optional alternates:
BUTTONDOWN_API_KEY=
BREVO_API_KEY=


# ─── Enrichment Engine ───────────────────────────────────────────────────────
# Unsplash API (free, required for cover_image / gallery_images enrichment)
# Register at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=t6tORXHJctu8JlXSUOOwMxuQxQvb8Ssp2xm0Ms1_Xcc

# OpenRouteService (free, required for route_options enrichment)
# Register at: https://openrouteservice.org
ORS_API_KEY=eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6IjRmNTRiOGQyYTQxMDRmMWQ5YTZlNzYwYWViZDBlYmUwIiwiaCI6Im11cm11cjY0In0=

# Cron secret — set in Vercel environment vars, used to authenticate /api/enrichment/process
# Generate with: openssl rand -hex 32
CRON_SECRET=e8f4c5956f5f1cda62814ce965af6a873770140b205a0b37170dcb5f3b698215

# Default LLM provider for enrichment jobs (gemini | groq | nvidia | openai)
# Uses one of the providers already configured above
ENRICHMENT_LLM_PROVIDER=gemini
